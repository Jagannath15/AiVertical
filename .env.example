# ── LLM (OpenAI-compatible API) ──────────────────────────────────────────────
# Set LLM_ALLOW_CLOUD=true to permit calls to external cloud LLM providers.
# Default is false. To switch to a local model (Ollama/vLLM), change
# LLM_BASE_URL and set LLM_ALLOW_CLOUD=false — no other code change needed.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
LLM_API_KEY=
LLM_ALLOW_CLOUD=false

# ── GitHub ────────────────────────────────────────────────────────────────────
# Personal Access Token with `repo` scope (status checks + PR comments).
# Passed to docker-compose as GITHUB_TOKEN; JCasC picks it up for the credential.
# Store the real value in Jenkins credentials (ID: github-token), not here.
GITHUB_TOKEN=
# Target repository in org/repo format, e.g. myorg/backend.
# Used by Phase 2+ scripts (ai_review.py, post_comment.py).
GH_REPO=YOUR_ORG/YOUR_REPO

# ── Jenkins ───────────────────────────────────────────────────────────────────
# REQUIRED: set a strong password before running docker compose up.
# docker-compose will refuse to start if this is unset.
JENKINS_ADMIN_PASSWORD=
# Public-facing URL Jenkins uses for GitHub status check links.
# Example: http://localhost:8080  (local dev) or https://ci.example.com
JENKINS_URL=http://localhost:8080

# ── Chatbot (Phase 4) ─────────────────────────────────────────────────────────
# Qdrant vector DB host (self-hosted Docker service)
QDRANT_HOST=localhost
QDRANT_PORT=6333
# Chatbot web server port
CHATBOT_PORT=3000
